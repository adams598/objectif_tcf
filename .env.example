# =============================================================================
# Objectif TCF — variables d'environnement
# =============================================================================
#
# LOCAL  → copiez .env.local.example vers .env.local (localhost, jamais l'URL Vercel)
# PROD   → importez .env.vercel dans le dashboard Vercel (une fois, persistant)
#
# Guide : docs/environnements-local-prod.md
# Vérif  : npm run env:check
#
# =============================================================================

# --- Base de données (Neon PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- JWT (local : valeurs dev ; prod : secrets ≥ 32 caractères) ---
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- URLs (local uniquement dans .env.local — prod = dashboard Vercel) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Emails ---
# Option A — Gmail SMTP (sans domaine pro, recommandé au démarrage)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Objectif TCF"

# Option B — Resend (domaine vérifié requis pour tous les destinataires)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="Objectif TCF"
CONTACT_EMAIL="objectiftcf4c2@gmail.com"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloudinary ---
# Stockage fichiers — Vercel Blob (recommandé)
BLOB_READ_WRITE_TOKEN=""

# Optionnel — lecture d'anciennes URLs Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# --- Admin (npm run db:seed-admin) ---
ADMIN_EMAIL="admin@votredomaine.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrateur Objectif TCF"

# --- pawaPay (docs/pawapay-setup.md) ---
PAWAPAY_API_TOKEN=""
PAWAPAY_ENV="sandbox"
# PAWAPAY_CALLBACK_URL=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Paiements ---
# true = mode démo si aucun provider configuré
PAYMENTS_MOCK_MODE="false"

# --- Cron (expiration abonnements) ---
# Header Authorization: Bearer <CRON_SECRET> pour /api/cron/subscriptions
CRON_SECRET=""

# --- Facturation (PDF / mentions légales) ---
INVOICE_COMPANY_LEGAL_NAME="Objectif Canada TCF"
INVOICE_COMPANY_TRADE_NAME="Objectif TCF"
# Lignes séparées par \n dans la variable (ex. adresse, CP, ville)
INVOICE_COMPANY_ADDRESS="Plateforme e-learning\nService numérique de préparation aux examens"
INVOICE_COMPANY_EMAIL="objectiftcf4c2@gmail.com"
# Optionnel — à renseigner pour conformité FR/UE
INVOICE_SIRET=""
INVOICE_VAT_NUMBER=""
INVOICE_RCS=""
INVOICE_CAPITAL=""

# --- Optionnel ---
BCRYPT_ROUNDS="12"
GEMINI_API_KEY=""

# Doc : docs/environnements-local-prod.md
