# =============================================================================
# Copiez ce fichier vers .env.local (gitignored) — DÉVELOPPEMENT LOCAL UNIQUEMENT
# =============================================================================
# Ne mettez PAS l'URL Vercel ici : gardez localhost pour tester sans reconfig.
# La production utilise les variables du dashboard Vercel (.env.vercel → import).
#
# Vérification : npm run env:check
# =============================================================================

DATABASE_URL=""
DIRECT_URL=""

JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Toujours localhost en local (Google OAuth suit l'URL du navigateur)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

RESEND_API_KEY=""
# Domaine vérifié dans Resend (ex. noreply@votredomaine.com).
# Pour les tests uniquement : onboarding@resend.dev (destinataires limités).
# Ne pas utiliser Gmail/Outlook comme expéditeur — Resend le refuse.
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="Objectif TCF"
# Boîte réelle pour les messages du formulaire Contact
CONTACT_EMAIL=""

# Même client OAuth que la prod : les 2 redirect URI dans Google Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stockage fichiers (admin, avatars, enregistrements EO) — Vercel Dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=""

# Optionnel — anciennes URLs Cloudinary déjà en base uniquement
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrateur Objectif TCF"

PAWAPAY_API_TOKEN=""
PAWAPAY_ENV="sandbox"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

PAYMENTS_MOCK_MODE="false"

# Cron — expiration des abonnements (/api/cron/subscriptions)
CRON_SECRET="dev-cron-secret"
BCRYPT_ROUNDS="12"
GEMINI_API_KEY=""
