generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================
// ENUMERATIONS
// ===========================

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  CORRECTOR
}

enum ExamType {
  TCF_CANADA
  TEF_CANADA
  IELTS
  DELF
  DALF
  TOEFL
  AUTRE
}

enum Skill {
  COMPREHENSION_ORALE
  COMPREHENSION_ECRITE
  EXPRESSION_ECRITE
  EXPRESSION_ORALE
  LEXIQUE
}

enum DifficultyLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum NCLCLevel {
  NCLC_1
  NCLC_2
  NCLC_3
  NCLC_4
  NCLC_5
  NCLC_6
  NCLC_7
  NCLC_8
  NCLC_9
  NCLC_10
  NCLC_11
  NCLC_12
}

enum QuestionType {
  QCM
  TRUE_FALSE
  TEXT_INPUT
  AUDIO
  WRITING_TASK
  SPEAKING_TASK
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  TIMED_OUT
}

enum CorrectionStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  DISPUTED
}

enum WritingCorrectionJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  EXAM_RESULT
  NEW_MESSAGE
  CORRECTION_DONE
  SUBSCRIPTION_EXPIRY
  ACHIEVEMENT
  SYSTEM
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIALING
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  PAWAPAY
  CINETPAY
  FLUTTERWAVE
  STRIPE
  PAYPAL
  MOCK
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  MOBILE_MONEY_MTN
  MOBILE_MONEY_ORANGE
  MOBILE_MONEY_AIRTEL
  MOBILE_MONEY_WAVE
  MOBILE_MONEY_MOOV
  PAYPAL
  GOOGLE_PAY
  BANK_TRANSFER
  SEPA
  UNKNOWN
}

enum PaymentCurrency {
  XAF
  XOF
  USD
  EUR
}

enum ImmigrationObjective {
  RESIDENCE_PERMANENTE
  ETUDES
  TRAVAIL
  CITOYENNETE
  AUTRE
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

// ===========================
// USER & AUTH
// ===========================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  emailVerified     Boolean   @default(false)
  name              String
  firstName         String?
  lastName          String?
  avatarUrl         String?
  phone             String?
  country           String?
  gender            Gender?
  birthDate         DateTime?
  nativeLanguage    String?
  role              Role      @default(USER)
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  /** Mot de passe chiffré (AES) pour consultation admin uniquement — pas le hash de connexion. */
  adminPasswordEnc  String?

  // Onboarding
  onboardingCompleted Boolean  @default(false)
  immigrationObjective ImmigrationObjective?
  targetExamDate      DateTime?
  currentLevel        LanguageLevel?
  targetCountry       String?

  // Stats
  totalStudyTime      Int      @default(0) // minutes
  currentStreak       Int      @default(0) // days
  longestStreak       Int      @default(0)
  lastStudyDate       DateTime?

  // Relations
  sessions          Session[]
  accounts          Account[]
  passwordResets    PasswordReset[]
  emailVerifications EmailVerification[]
  subscriptions     Subscription[]
  payments          Payment[]
  attempts          Attempt[]
  answers           Answer[]
  progress          Progress[]
  notifications     Notification[]
  settings          UserSettings?
  auditLogs         AuditLog[]
  sentMessages      Message[]          @relation("SentMessages")
  receivedMessages  Message[]          @relation("ReceivedMessages")
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  communityLikes    CommunityLike[]
  corrections       Correction[]       @relation("CorrectorCorrections")
  submittedWork     Correction[]       @relation("StudentCorrections")
  writingCorrectionJobs WritingCorrectionJob[]
  createdExamSeries ExamSeries[]       @relation("ExamSeriesCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ===========================
// SUBSCRIPTIONS & PAYMENTS
// ===========================

model Subscription {
  id              String             @id @default(uuid())
  userId          String
  examType        ExamType           @default(TCF_CANADA)
  plan            SubscriptionPlan   @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  /** Renouvellement automatique activé à la souscription ; coupé à l'annulation. */
  autoRenew          Boolean         @default(true)
  cancelAtPeriodEnd  Boolean         @default(false)
  /** Durée de chaque période (jours de l'offre choisie), utilisée pour le renouvellement. */
  renewalDays        Int?
  offerId            String?
  stripeSubscriptionId String?       @unique
  stripeCustomerId     String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, examType])
  @@index([userId])
  @@index([status])
  @@index([userId, examType, status])
  @@index([stripeCustomerId])
  @@index([autoRenew, cancelAtPeriodEnd, currentPeriodEnd])
}

model Payment {
  id               String           @id @default(uuid())
  userId           String
  subscriptionId   String?
  amount           Int
  currency         PaymentCurrency  @default(XAF)
  status           PaymentStatus    @default(PENDING)
  provider         PaymentProvider?
  method           PaymentMethod?
  providerReference String?         @unique
  externalId       String?          @unique
  checkoutUrl      String?
  stripePaymentId  String?          @unique
  description      String?
  examType         ExamType?
  offerId          String?
  subscriptionDays Int?
  amountXaf        Int?
  amountXof        Int?
  amountUsd        Int?
  amountEur        Int?
  metadata         Json?
  failureReason    String?
  paidAt           DateTime?
  deletedAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@index([deletedAt])
}

// ===========================
// EXAMS & CONTENT
// ===========================

model Exam {
  id          String   @id @default(uuid())
  type        ExamType
  title       String
  description String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?

  series ExamSeries[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model ExamSeries {
  id           String          @id @default(uuid())
  examId       String
  skill        Skill
  title        String
  description  String?
  difficulty   DifficultyLevel @default(B1)
  durationMin  Int             @default(30)
  totalPoints  Int             @default(0)
  order        Int             @default(0)
  isPublished  Boolean         @default(false)
  isFree       Boolean         @default(false)
  isCustomContent Boolean      @default(false)
  audioUrl     String?
  videoUrl     String?
  imageUrl     String?
  deletedAt    DateTime?
  createdById  String?

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("ExamSeriesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([skill])
  @@index([difficulty])
  @@index([isPublished])
  @@index([createdById])
}

model Question {
  id           String       @id @default(uuid())
  seriesId     String
  type         QuestionType
  content      String
  instruction  String?
  audioUrl     String?
  videoUrl     String?
  imageUrl     String?
  order        Int          @default(0)
  points       Int          @default(1)
  timeLimit    Int?         // secondes
  explanation  String?
  deletedAt    DateTime?

  series  ExamSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  choices Choice[]
  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seriesId])
  @@index([type])
  @@index([order])
}

model Choice {
  id         String  @id @default(uuid())
  questionId String
  content    String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

// ===========================
// ATTEMPTS & RESULTS
// ===========================

model Attempt {
  id          String        @id @default(uuid())
  userId      String
  seriesId    String
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  durationSec Int?          // durée réelle en secondes
  score       Float?        // score obtenu
  maxScore    Float?        // score maximum possible
  percentage  Float?        // pourcentage
  nclcLevel   NCLCLevel?
  // Progression persistée pour reprise après déconnexion
  currentOrder Int?         // ordre (1-based) de la question / tâche en cours
  elapsedSec   Int?         // temps déjà écoulé en secondes

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  series  ExamSeries @relation(fields: [seriesId], references: [id])
  answers Answer[]
  result  Result?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([seriesId])
  @@index([status])
  @@index([userId, seriesId])
}

model Answer {
  id            String   @id @default(uuid())
  attemptId     String
  questionId    String
  userId        String
  choiceId      String?  // pour QCM
  textResponse  String?  // pour EE/EO
  audioUrl      String?  // pour EO
  isCorrect     Boolean?
  pointsEarned  Float?
  timeTakenSec  Int?
  correction    Correction?

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  choice   Choice?  @relation(fields: [choiceId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([userId])
}

model Result {
  id          String    @id @default(uuid())
  attemptId   String    @unique
  // Scores par compétence
  scoreCorale Float?
  scoreCecrit Float?
  scoreEecrit Float?
  scoreEoral  Float?
  scoreLexiq  Float?
  // Score global
  globalScore Float?
  nclcLevel   NCLCLevel?
  feedback    String?
  strengths   String[]
  improvements String[]

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attemptId])
}

// ===========================
// PROGRESS
// ===========================

model Progress {
  id         String    @id @default(uuid())
  userId     String
  skill      Skill
  level      Float     @default(0) // 0-100
  nclcLevel  NCLCLevel?
  weeklyGoal Int       @default(5) // exercices/semaine
  weeklyDone Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skill])
  @@index([userId])
}

// ===========================
// CORRECTIONS
// ===========================

model Correction {
  id           String           @id @default(uuid())
  answerId     String           @unique
  correctorId  String?          // null = IA
  studentId    String
  status       CorrectionStatus @default(PENDING)
  score        Float?
  maxScore     Float?
  feedback     String?
  rubric       Json?            // critères de notation JSON
  isAiGenerated Boolean        @default(false)
  correctedAt  DateTime?

  answer    Answer @relation(fields: [answerId], references: [id])
  corrector User?  @relation("CorrectorCorrections", fields: [correctorId], references: [id])
  student   User   @relation("StudentCorrections", fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([correctorId])
  @@index([studentId])
  @@index([status])
}

model WritingCorrectionJob {
  id               String                     @id @default(uuid())
  status           WritingCorrectionJobStatus @default(PENDING)
  seriesId         String
  userId           String?
  accessToken      String                     @unique
  tasksPayload     Json
  provisionalScore Json
  result           Json?
  resultSource     String?
  attempts         Int                        @default(0)
  lastError        String?
  expiresAt        DateTime
  completedAt      DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([accessToken])
  @@index([userId])
  @@index([expiresAt])
}

// ===========================
// COMMUNITY & MESSAGING
// ===========================

model CommunityPost {
  id       String   @id @default(uuid())
  authorId String
  content  String
  tags     String[]
  examType ExamType?
  imageUrl String?
  deletedAt DateTime?

  author   User               @relation(fields: [authorId], references: [id])
  comments CommunityComment[]
  likes    CommunityLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([examType])
}

model CommunityComment {
  id       String   @id @default(uuid())
  postId   String
  authorId String
  content  String
  deletedAt DateTime?

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model CommunityLike {
  id     String @id @default(uuid())
  postId String
  userId String

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Message {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  readAt     DateTime?
  deletedAt  DateTime?

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}

// ===========================
// PRICING & OFFERS
// ===========================

model ExamPricingConfig {
  id             String   @id @default(uuid())
  examType       ExamType @unique
  pricePerDayXaf Int      @default(1000)
  pricePerDayUsd Int      @default(2)
  pricePerDayXof Int      @default(1250)
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionOffer {
  id         String    @id @default(uuid())
  examType   ExamType
  name       String
  slug       String
  subtitle   String?
  priceXaf   Int
  priceUsd   Int
  priceXof   Int
  baseDays   Int
  bonusDays  Int       @default(0)
  features   Json      @default("[]")
  sortOrder  Int       @default(0)
  isFeatured Boolean   @default(true)
  isActive   Boolean   @default(true)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examType, slug])
  @@index([examType, isFeatured, isActive])
}

// ===========================
// NOTIFICATIONS & SETTINGS
// ===========================

model Notification {
  id      String           @id @default(uuid())
  userId  String
  type    NotificationType
  title   String
  message String
  data    Json?
  readAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([readAt])
}

model UserSettings {
  id                   String  @id @default(uuid())
  userId               String  @unique
  language             String  @default("fr-FR")
  theme                String  @default("light")
  emailNotifications        Boolean @default(true)
  pushNotifications         Boolean @default(false)
  studyReminders            Boolean @default(true)
  examResultNotifications   Boolean @default(true)
  weeklyReportNotifications Boolean @default(true)
  reminderTime         String  @default("09:00")
  weeklyGoalDays       Int     @default(5)
  dailyGoalMinutes     Int     @default(30)
  publicProfile        Boolean @default(true)
  showInLeaderboard    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================
// AUDIT LOGS
// ===========================

model AuditLog {
  id        String  @id @default(uuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}
