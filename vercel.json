{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/subscriptions",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "app/api/paiement/webhook/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/paiement/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/cron/subscriptions/route.ts": {
      "maxDuration": 30
    }
  }
}
